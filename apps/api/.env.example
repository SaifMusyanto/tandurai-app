# Backend Tandurai (IoT + data aplikasi) — salin ke apps/api/.env (jangan di-commit).
PORT=8787
DATABASE_URL=postgres://postgres@localhost:5433/tandurai_iot

# Broker MQTT (dev: npm run broker:dev -w apps/api; produksi: deploy/docker-compose.yml)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=tandurai-backend
MQTT_PASSWORD=ganti-password-backend
MQTT_CLIENT_ID=tandurai-backend

# Auth dashboard: firebase (default) | dev (hanya lokal: header "Bearer dev:<uid>")
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=tandurai-ai
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Perilaku
COMMAND_TTL_SEC=30
OFFLINE_AFTER_SEC=180
HISTORY_BUCKET_SEC=600
HISTORY_RETENTION_DAYS=180
TELEMETRY_INTERVAL_SEC=10

# API internal AI worker lokal (local_ai_worker, DATA_SOURCE=api). Minimal 16 karakter acak;
# isi nilai yang sama di local_ai_worker/.env. Kosong = API worker nonaktif.
WORKER_TOKEN=

# Alamat broker yang diisi ke gateway. Uji di jaringan lokal: IP LAN komputer yang menjalankan broker
# (cek dengan `ipconfig`, mis. 192.168.1.10). Produksi: IP publik / domain server, mis. mqtt.tandurai.id.
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=1883
MQTT_PUBLIC_TLS=false

# Admin Tandurai (boleh membuka halaman Registrasi Perangkat). Email terverifikasi, pisahkan koma.
ADMIN_EMAILS=

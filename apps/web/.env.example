# Firebase Web App configuration (hanya Authentication: Google / email). Copy to .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional trusted server-side chat proxy. Never put provider secrets in VITE_*.
VITE_CHAT_API_URL=

# Backend Tandurai (apps/api): seluruh data aplikasi + IoT lewat REST + SSE (pengganti Firebase RTDB).
VITE_API_URL=http://localhost:8787/api

# Kumbung/sensor default lama (fallback pemilihan konteks).
VITE_DEFAULT_FARM_ID=FARM-01
VITE_DEFAULT_KUMBUNG_ID=FARM-01-K01
VITE_DEFAULT_SENSOR_ID=SNS-0101

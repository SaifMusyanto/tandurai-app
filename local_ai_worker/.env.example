# Sumber data: api (backend Tandurai + PostgreSQL, disarankan) atau firebase (RTDB lama)
DATA_SOURCE=api
BACKEND_URL=http://localhost:8787/api
# Sama dengan WORKER_TOKEN di apps/api/.env (minimal 16 karakter)
WORKER_TOKEN=
REQUEST_TIMEOUT_SECONDS=20
# Hanya untuk DATA_SOURCE=firebase
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_CREDENTIALS_PATH=credentials/firebase-admin.json
DEFAULT_FARM_ID=FARM-01
DEFAULT_KUMBUNG_ID=FARM-01-K01
DEFAULT_SENSOR_ID=SNS-0101
TIMEZONE=Asia/Jakarta
FORECAST_RUN_HOUR=00:15
WORKER_LOG_DIR=runtime/logs
WORKER_STATE_DIR=runtime/state
MODEL_MODULE_PATH=../ai_model

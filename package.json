{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "concurrently --kill-others --raw",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
    "test:rules": "powershell -ExecutionPolicy Bypass -File tools/run-database-rules-tests.ps1",
    "deploy:rules:demo": "firebase deploy --only database --project demo",
    "test:telemetry": "node --test tests/telemetry.test.mjs",
    "test:stage3": "npm run test:telemetry && npm run test:rules",
    "simulate:telemetry": "node tools/telemetry-simulator.mjs",
    "simulate:gateway": "node tools/gateway-simulator.mjs",
    "test:gateway-sim": "powershell -ExecutionPolicy Bypass -File tools/run-database-rules-tests.ps1 -Only auth,database -Command \"node tools/gateway-sim-e2e.mjs\"",
    "test:operations": "node --test tests/operations.test.mjs",
    "test:stage4": "npm run test:telemetry && npm run test:operations && npm run test:rules",
    "test:worker": "local_ai_worker\\.venv\\Scripts\\python.exe -m pytest local_ai_worker\\tests -q",
    "worker:health": "local_ai_worker\\.venv\\Scripts\\python.exe -m worker health",
    "worker:watch": "local_ai_worker\\.venv\\Scripts\\python.exe -m worker watch --interval 3",
    "alerts:local": "npm run alerts:local --prefix functions",
    "alerts:once": "npm run alerts:once --prefix functions",
    "alerts:test-telegram": "npm run alerts:test-telegram --prefix functions",
    "alerts:validate": "npm run alerts:validate --prefix functions",
    "alerts:bind-chat": "npm run alerts:bind-chat --prefix functions --"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "firebase": "^12.14.0"
  }
}

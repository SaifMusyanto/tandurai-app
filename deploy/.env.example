# Konfigurasi deploy Tandurai (satu VM). Salin: cp .env.example .env  lalu isi.
# File .env ini RAHASIA: chmod 600, jangan di-commit.

# ── Domain (record A keduanya → IP statis VM) ───────────────────────────────
DASHBOARD_DOMAIN=dashboard.tandurai.id
MQTT_DOMAIN=mqtt.tandurai.id
# Email untuk Let's Encrypt (pemberitahuan sertifikat)
ACME_EMAIL=admin@tandurai.id

# ── Rahasia: buat masing-masing dengan  openssl rand -hex 32  ───────────────
# Pakai hex saja (tanpa karakter khusus) karena ikut masuk ke URL database.
POSTGRES_PASSWORD=
MQTT_PASSWORD=
WORKER_TOKEN=

# ── Admin Tandurai (boleh membuka Registrasi Perangkat), pisahkan koma ──────
ADMIN_EMAILS=

# ── Firebase Web App (hanya Authentication). Nilai ini publik: ikut ke browser ─
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_CHAT_API_URL=

# ── Perilaku (boleh dibiarkan) ──────────────────────────────────────────────
HISTORY_RETENTION_DAYS=180
OFFLINE_AFTER_SEC=180

# Dashboard (apps/web) dibangun lalu disajikan Caddy, yang juga menjadi reverse proxy /api + HTTPS otomatis.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
# Paket "firebase" yang dipakai dashboard ada di package.json root, jadi root ikut dipasang.
RUN npm ci --workspace apps/web --include-workspace-root

COPY apps/web apps/web

# Nilai VITE_* ikut ke bundle browser (publik). Jangan isi rahasia di sini.
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_MEASUREMENT_ID
ARG VITE_CHAT_API_URL
ARG VITE_API_URL
ENV NODE_ENV=production
RUN npm run build --workspace apps/web

FROM caddy:2.10-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist/apps/web /srv
